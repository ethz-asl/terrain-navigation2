<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <!-- <node pkg="tf" type="static_transform_publisher" name="world_map" args="0 0 0 0 0 0 world map 10"/> -->
  <node pkg="terrain_planner_benchmark" exec="test_rrt_wavelet" name="rrt_planner" output="screen">
    <param name="location" value="wsmr"/>
    <param name="map_path" value="$(find-pkg-share terrain_models)/models/wsmr_wavelet_quadtree"/>
    <param name="output_directory" value="$(find-pkg-share terrain_planner_benchmark)/../output"/>
    <!-- Part 107 AGL altitude limits: floor/ceiling are elevation directly
         below the vehicle plus a fixed offset, not a 3D clearance radius. -->
    <param name="min_agl" value="50.0"/>
    <param name="max_agl" value="120.0"/>
  </node>
  <node pkg="rviz2" exec="rviz2" name="rviz" args="-d $(find-pkg-share terrain_planner_benchmark)/launch/config.rviz" />
</launch>
